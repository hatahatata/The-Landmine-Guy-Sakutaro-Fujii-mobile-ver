  "productName": "学生成績AI診断",
  "version": "1.0.0",
  "identifier": "com.example.studentgradeai",
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "devUrl": "http://localhost:5173",
    "frontendDist": "dist"
  },
  "app": {
    "windows": [
