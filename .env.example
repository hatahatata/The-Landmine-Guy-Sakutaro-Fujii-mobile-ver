# Local development uses the FastAPI server on this URL.
PYTHON_API_URL=http://127.0.0.1:8000
VITE_API_BASE_URL=http://127.0.0.1:8000
VITE_GOOGLE_CLIENT_ID=YOUR_GOOGLE_CLIENT_ID_HERE
# Set SONY_API_KEY only in the backend environment (for example, Render).
SONY_API_KEY=YOUR_SONY_API_KEY_HERE
SONY_API_URL=https://user-api.predictionone.sony.biz/v1/groups/qejw062trt0qwwav/classifiers/quipaioomqira6hd/inference
# Local development origins. Set the real Cloudflare Pages origin in Render's CORS_ORIGINS.
CORS_ORIGINS=http://127.0.0.1:5173,http://localhost:5173
# Local SQLite path. Render uses /tmp/rooms.db in render.yaml; it is temporary there.
ROOMS_DB_PATH=backend/rooms.db

# Production values are configured outside this file:
# - Cloudflare Pages: VITE_API_BASE_URL = the actual Render API URL
# - Render backend: CORS_ORIGINS = the actual Cloudflare Pages origin
# - Render backend: SONY_API_KEY is configured only in Render Environment variables
